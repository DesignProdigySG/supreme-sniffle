# Neo4j — either a local instance (see docker-compose.yml) or an AuraDB Free
# instance (recommended for the POC: neo4j.com/product/auradb, no infra to run).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Used by `extract-brief` to pull {person, account, role, confirmation} out of
# Jocelyn's account-brief prose.
ANTHROPIC_API_KEY=
