files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

fail=0

# Known secret-format detection (AWS/GCP/Slack/private keys/etc.)
npx secretlint --maskSecrets $files || fail=1

# Direct check for common API key prefixes, wherever they show up.
# (Excludes this hook's own file, since it necessarily contains these
# patterns as literal regex text, not real secrets.)
if git diff --cached -U0 -- $files ':(exclude).husky/pre-commit' | grep -qE '^\+.*(sk-ant-api[0-9]{2}-|sk-proj-|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|glpat-[A-Za-z0-9_-]{20}|xox[baprs]-[A-Za-z0-9-]{10,})'; then
  echo "pre-commit: a staged change looks like a real API key/token. Blocking commit." >&2
  fail=1
fi

# .env.example / .env.sample / .env.template must stay placeholders — flag any
# assigned value that doesn't look like an obvious placeholder.
for f in $files; do
  case "$f" in
    *.env.example|*.env.sample|*.env.template|*.example|*.sample|*.template)
      lines=$(git show ":$f" 2>/dev/null | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' || true)
      [ -z "$lines" ] && continue
      old_ifs=$IFS
      IFS='
'
      for line in $lines; do
        value=$(echo "$line" | sed -E 's/^[A-Za-z_][A-Za-z0-9_]*=//')
        [ -z "$value" ] && continue
        if echo "$value" | grep -qiE '^(change-me|your-|<|xxx|placeholder|example|localhost|none)'; then
          continue
        fi
        if [ "${#value}" -ge 16 ]; then
          echo "pre-commit: $f line '$line' looks like a real secret, not a placeholder. Blocking commit." >&2
          fail=1
        fi
      done
      IFS=$old_ifs
      ;;
  esac
done

exit $fail
